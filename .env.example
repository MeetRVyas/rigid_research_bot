GEMINI_API_KEY1=
GEMINI_API_KEY2=
# Add more if you want

LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text         # text | json  (json is friendlier for log aggregators)

# Semantic Scholar (optional)
# Without a key: ~1 req/s (plenty for interactive use).
# With a key:   ~10 req/s (better for bulk workflows).
# Apply free at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Outbound HTTP behavior
# Overall wall-clock budget (seconds) for a single tool call's external
# HTTP work, including retries. Keep this comfortably under your hosting
# platform's own hard request timeout.
REQUEST_DEADLINE_SECONDS=20